		{"id":"3bab4757a1579eb1","type":"file","file":"10_Obsidian_System/50_Image/R301/image/GMS_CATG2_LP109_SETVALUE3.png","x":-33620,"y":-70588,"width":400,"height":268},
		{
			"id":"48cef7ad48f5d35b",
			"type":"text",
			"text":"F23_B10_Z3\nProgram control Start Step\nIN1096\n#IN1096\n",
			"styleAttributes":{"textAlign":"center"},
